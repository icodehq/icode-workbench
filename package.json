{
  "name": "icode",
  "version": "0.6.0",
  "private": true,
  "description": "iCode — the next-gen agentic development environment for local coding agents",
  "license": "MIT",
  "homepage": "https://github.com/LoongLab/iCode",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LoongLab/iCode.git"
  },
  "bugs": {
    "url": "https://github.com/LoongLab/iCode/issues"
  },
  "main": "./out/main/index.js",
  "desktopName": "iCode.desktop",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "postinstall": "node config/scripts/rebuild-native.cjs",
    "dev": "electron-vite dev",
    "start": "electron .",
    "build:app": "electron-vite build && node config/scripts/build-host.cjs",
    "typecheck": "tsc -p config/tsconfig.node.json --noEmit && tsc -p config/tsconfig.web.json --noEmit",
    "build": "pnpm typecheck && pnpm build:app",
    "gate:sqlite": "pnpm build:app && node config/scripts/gates.cjs sqlite",
    "gate:pty": "node config/scripts/gates.cjs pty",
    "gate:host:start": "pnpm build:app && node config/scripts/gates.cjs host-start",
    "gate:host:verify": "node config/scripts/gates.cjs host-verify",
    "gate:reattach": "pnpm build:app && node config/scripts/gates.cjs reattach",
    "gate:host:stop": "node config/scripts/gates.cjs host-stop",
    "package:dir": "pnpm build && node config/scripts/package.cjs dir",
    "package:linux": "pnpm build && node config/scripts/package.cjs linux",
    "package:win": "pnpm build && node config/scripts/package.cjs win",
    "package:mac": "pnpm build && node config/scripts/package.cjs mac",
    "verify:package": "node config/scripts/verify-package.cjs",
    "gate:packaged": "node config/scripts/gates.cjs packaged",
    "smoke:packaged:win": "node tests/compat/packaged-smoke-win.cjs",
    "smoke:packaged:mac": "node tests/compat/packaged-smoke-mac.cjs",
    "build:host": "node config/scripts/build-host.cjs",
    "build:wsl-host": "node config/scripts/wsl/host-artifacts.cjs build",
    "verify:wsl-host": "node config/scripts/wsl/verify-artifacts.cjs artifacts/wsl-host/linux-x64",
    "selftest:wsl-host": "node tests/wsl/selftest-verifier.cjs",
    "selftest:wsl-prepare": "node tests/wsl/selftest-prepare-artifacts.cjs",
    "smoke:wsl-host": "node tests/wsl/smoke-materialized.cjs",
    "smoke:wsl-host-baselines": "node tests/wsl/smoke-baselines.cjs",
    "test": "vitest run --config config/vitest.config.mts",
    "smoke:ui": "node tests/compat/ui-smoke.cjs",
    "smoke:claude": "node tests/compat/claude-tui-smoke.cjs",
    "smoke:worktree": "node tests/compat/worktree-isolation-smoke.cjs",
    "test:watch": "vitest --config config/vitest.config.mts",
    "check:brand": "node config/scripts/check-brand.cjs",
    "perf:scm": "node config/scripts/gates.cjs perf-scm",
    "smoke:activity": "node tests/compat/activity-smoke.cjs",
    "smoke:features": "node tests/compat/feature-smoke.cjs",
    "smoke:projects": "node tests/compat/project-onboarding-smoke.cjs",
    "smoke:scm": "node tests/compat/scm-smoke.cjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "chokidar": "4.0.3",
    "lucide-react": "0.577.0",
    "monaco-editor": "0.57.0",
    "node-pty": "1.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "43.7.8",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "author": {
    "name": "iCode contributors",
    "email": "icode-maintainers@users.noreply.github.com"
  }
}
