{
  "name": "icode",
  "version": "0.1.0",
  "private": true,
  "description": "iCode — an agent development environment for local Coding Agent TUIs",
  "license": "MIT",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "postinstall": "node config/scripts/rebuild-native.cjs",
    "dev": "electron-vite dev",
    "start": "electron .",
    "build:app": "electron-vite build && node config/scripts/build-host.cjs",
    "typecheck": "tsc -p config/tsconfig.node.json --noEmit && tsc -p config/tsconfig.web.json --noEmit",
    "build": "pnpm typecheck && pnpm build:app",
    "gate:sqlite": "pnpm build:app && electron . --icode-gate-sqlite",
    "gate:pty": "ELECTRON_RUN_AS_NODE=1 electron tests/compat/pty-smoke.cjs",
    "gate:host:start": "pnpm build:app && ICODE_HOST_DIR=/tmp/icode-work1/host ICODE_HOST_SOCKET=/tmp/icode-work1/host/terminal-host.sock electron . --icode-gate-host-start",
    "gate:host:verify": "ICODE_HOST_SOCKET=/tmp/icode-work1/host/terminal-host.sock ELECTRON_RUN_AS_NODE=1 electron tests/compat/host-verify.cjs",
    "gate:reattach": "pnpm build:app && ICODE_HOST_DIR=/tmp/icode-work1/host ICODE_HOST_SOCKET=/tmp/icode-work1/host/terminal-host.sock electron . --icode-gate-reattach",
    "gate:host:stop": "ICODE_HOST_SOCKET=/tmp/icode-work1/host/terminal-host.sock ELECTRON_RUN_AS_NODE=1 electron tests/compat/host-stop.cjs",
    "package:dir": "pnpm build && node config/scripts/wsl/prepare-artifacts.cjs && electron-builder --dir --config config/electron-builder.config.cjs",
    "package:win": "pnpm build && node config/scripts/wsl/prepare-artifacts.cjs && electron-builder --win nsis --x64 --config config/electron-builder.config.cjs",
    "gate:packaged": "node tests/compat/packaged-smoke.cjs",
    "build:host": "node config/scripts/build-host.cjs",
    "build:wsl-host": "node config/scripts/wsl/host-artifacts.cjs build",
    "verify:wsl-host": "node config/scripts/wsl/verify-artifacts.cjs artifacts/wsl-host/linux-x64",
    "selftest:wsl-host": "node tests/wsl/selftest-verifier.cjs",
    "selftest:wsl-prepare": "node tests/wsl/selftest-prepare-artifacts.cjs",
    "smoke:wsl-host": "node tests/wsl/smoke-materialized.cjs",
    "smoke:wsl-host-baselines": "node tests/wsl/smoke-baselines.cjs",
    "test": "vitest run --config config/vitest.config.mts",
    "smoke:ui": "node tests/compat/ui-smoke.cjs",
    "smoke:claude": "node tests/compat/claude-tui-smoke.cjs",
    "smoke:worktree": "node tests/compat/worktree-isolation-smoke.cjs",
    "test:watch": "vitest --config config/vitest.config.mts",
    "check:brand": "node config/scripts/check-brand.cjs",
    "perf:scm": "ICODE_PERF=1 vitest run --config config/vitest.config.mts src/main/git/git-workspace-service.test.ts -t \"reads 10k untracked files\"",
    "smoke:activity": "node tests/compat/activity-smoke.cjs",
    "package:msi": "pnpm build && node config/scripts/wsl/prepare-artifacts.cjs && electron-builder --win msi --x64 --config config/electron-builder.config.cjs",
    "smoke:features": "node tests/compat/feature-smoke.cjs",
    "smoke:projects": "node tests/compat/project-onboarding-smoke.cjs",
    "smoke:scm": "node tests/compat/scm-smoke.cjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "chokidar": "4.0.3",
    "lucide-react": "0.577.0",
    "monaco-editor": "0.57.0",
    "node-pty": "1.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "43.7.8",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "author": "iCode contributors"
}
