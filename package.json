{
  "name": "ade",
  "version": "0.1.0",
  "private": true,
  "description": "ADE — an agent development environment for local Coding Agent TUIs",
  "license": "MIT",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "postinstall": "node scripts/rebuild-native.cjs",
    "dev": "electron-vite dev",
    "start": "electron .",
    "build:app": "electron-vite build && node scripts/build-host.cjs",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "build": "pnpm typecheck && pnpm build:app",
    "gate:sqlite": "pnpm build:app && electron . --ade-gate-sqlite",
    "gate:pty": "ELECTRON_RUN_AS_NODE=1 electron scripts/compat/pty-smoke.cjs",
    "gate:host:start": "pnpm build:app && ADE_HOST_DIR=/tmp/ade-work1/host ADE_HOST_SOCKET=/tmp/ade-work1/host/terminal-host.sock electron . --ade-gate-host-start",
    "gate:host:verify": "ADE_HOST_SOCKET=/tmp/ade-work1/host/terminal-host.sock ELECTRON_RUN_AS_NODE=1 electron scripts/compat/host-verify.cjs",
    "gate:reattach": "pnpm build:app && ADE_HOST_DIR=/tmp/ade-work1/host ADE_HOST_SOCKET=/tmp/ade-work1/host/terminal-host.sock electron . --ade-gate-reattach",
    "gate:host:stop": "ADE_HOST_SOCKET=/tmp/ade-work1/host/terminal-host.sock ELECTRON_RUN_AS_NODE=1 electron scripts/compat/host-stop.cjs",
    "package:dir": "pnpm build && electron-builder --dir --config config/electron-builder.config.cjs",
    "gate:packaged": "node scripts/compat/packaged-smoke.cjs",
    "build:host": "node scripts/build-host.cjs",
    "test": "vitest run --config vitest.config.mts",
    "smoke:ui": "node scripts/compat/ui-smoke.cjs",
    "smoke:claude": "node scripts/compat/claude-tui-smoke.cjs",
    "smoke:worktree": "node scripts/compat/worktree-isolation-smoke.cjs",
    "test:watch": "vitest --config vitest.config.mts",
    "smoke:review": "node scripts/compat/review-smoke.cjs",
    "smoke:activity": "node scripts/compat/activity-smoke.cjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "lucide-react": "0.577.0",
    "node-pty": "1.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "43.7.8",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
