{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": true,
    "baseUrl": "..",
    "paths": {
      "@shared/*": ["src/shared/*"]
    }
  },
  "include": [
    "../electron.vite.config.ts",
    "vitest.config.mts",
    "../src/main/**/*.ts",
    "../src/preload/**/*.ts",
    "../src/host/**/*.ts",
    "../src/shared/**/*.ts"
  ]
}
